# copy to terraform.tfvars (git-ignored) and fill in from the OCI console:
# Profile > My profile > API keys > Add API key
tenancy_ocid     = "ocid1.tenancy.oc1..xxxx"
user_ocid        = "ocid1.user.oc1..xxxx"
fingerprint      = "aa:bb:cc:..."
private_key_path = "~/.oci/oci_api_key.pem"
compartment_ocid = "ocid1.tenancy.oc1..xxxx" # root compartment = tenancy ocid is fine
region           = "us-sanjose-1"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_allowed_cidr    = "0.0.0.0/0"
ad_index            = 0
ocpus               = 2
memory_gb           = 12
