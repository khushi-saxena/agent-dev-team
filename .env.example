# copy to .env on the VM (git-ignored). never commit real values.

# fine-grained PAT from your account, this repo only: contents, issues, PRs, workflows = read/write
GH_TOKEN=
GH_REPO=khushi-saxena/confer-daily-briefing

# models. check what your plan actually has:
#   curl -s https://ollama.com/v1/models -H "Authorization: Bearer $OLLAMA_API_KEY" | jq -r '.data[].id'
OLLAMA_API_KEY=
STRONG_MODEL=gpt-oss:120b      # orchestrator, reviewer
CHEAP_MODEL=gpt-oss:20b        # builders, tester

# fallback when ollama returns 402/429. one key per agent = per-agent token attribution
OPENROUTER_API_KEY=
OPENROUTER_KEY_HERMES=
FALLBACK_STRONG=openrouter/openai/gpt-oss-120b:free
FALLBACK_CHEAP=openrouter/openai/gpt-oss-20b:free

# product-side, used by the briefing job itself (builders will read these)
FEED_URL=
